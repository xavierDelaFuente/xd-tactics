# Copy this file to .env and adjust if you changed docker-compose.yml's Postgres credentials.
# .env is gitignored; .env.example is the template that IS committed.

# Matches docker-compose.yml's postgres service (docker compose up -d).
DATABASE_URL=postgres://xd_tactics:xd_tactics@localhost:5432/xd_tactics

PORT=3001

# Riot development key (expires every 24h) — https://developer.riotgames.com
RIOT_API_KEY=
RIOT_PLATFORM=euw1
RIOT_REGION=europe
